// export: defined in Z, callable from C. The symbol keeps the name as written
// and is emitted .globl, while every other Z function is namespaced.
export int z_triple(int v) { return v * 3; }
export int z_sum_to(int n) {
    var s = 0;
    for (var i = 1; i <= n; i = i + 1) { s = s + i; }
    return s;
}

/* Not exported: namespaced, so C cannot accidentally bind to it. */
int internal(int v) { return v + 100; }

extern void c_call_back();

int main() {
    print(z_triple(7));      // 21
    print(z_sum_to(10));     // 55
    print(internal(1));      // 101
    c_call_back();
    return 0;
}
