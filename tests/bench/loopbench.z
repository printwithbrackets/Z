// Compute-bound loop: many locals in arithmetic - the register-allocator test.
int main() {
    var a = 3; var b = 5; var c = 7; var d = 11;
    var sum = 0;
    var i = 0;
    while (i < 20000000) {
        sum = sum + a * b + c * d - (a + c);
        i = i + 1;
    }
    Console.WriteLog(sum);
    return 0;
}
