// Modules. `import` splices a file's declarations into this one; a file is
// expanded once however many times it is named, so the diamond below is fine.
import "lib/math.z";
import "lib/shapes.z";
import "lib/math.z";

int main() {
    Console.WriteLog(triple(4));                            // 12
    Console.WriteLog(square(5));                            // 25
    Console.WriteLog(SCALE);                                // 3

    var v = add(new Vec(1, 2), new Vec(10, 20));
    Console.WriteLog(v.x);                                  // 11
    Console.WriteLog(v.y);                                  // 22

    var r = new Rect(3, 4);
    Console.WriteLog(area(r));                              // 12
    Console.WriteLog(scaled_area(r));                       // 36

    /* a struct, a const and a function all cross the boundary */
    Console.WriteLog(square(SCALE) + triple(2));            // 9 + 6 = 15
    return 0;
}
