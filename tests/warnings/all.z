// Every kind of warning the compiler can emit, in one file.

int unusedLocal(int unusedParam) {
    var neverRead = 1;
    return 0;
}

int shadowing() {
    var x = 1;
    {
        var x = 2;
        Console.WriteLog(x);
    }
    return x;
}

int unreachable() {
    return 1;
    Console.WriteLog("never");
}

void main() {
    Console.WriteLog(unusedLocal(0));
    Console.WriteLog(shadowing());
    Console.WriteLog(unreachable());
}
