// A struct declared twice, where the second declaration carries members.
//
// `type_define_struct` returns NULL for a name that is taken, and the
// declaration went on reading its members with nothing to attach them to. The
// "already defined" diagnostic was already correct; everything after it was
// working on a type that does not exist.
//
// Three forms are here because they reached it three different ways. A plain
// method died in `struct_add_method`, which reads the method count off the null.
// A destructor died earlier still, passing the null type to the mangler that
// builds its registered name. Fields were already guarded, which is why only the
// two kinds of member crashed and why each of those needed a guard of its own.
//
// None of the three is reported more than once, and none is a signal.

struct P {
    int a;
}

struct P {
    int a;
    int M() { return a; }
}

struct Q {
    int b;
}

struct Q {
    int b;
    ~Q() { b = 0; }
}

struct R {
    int c;
}

// The same name as a class, which is a different diagnostic and a different path.
class R {
    int c;
}

int main() {
    return 0;
}
