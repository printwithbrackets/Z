// Duration literals, and the `hold` builtin that waits for one.
//
// A duration is a number with a unit stuck to it: h for hours, m for minutes, s for
// seconds, and ms and us for the two below a second. Several can run together with
// nothing between them, and a trailing number with no unit of its own is seconds.
// So the three ways of writing the same wait are `37`, `37s` and `0h0m37`, and
// `hold(2h21m37)` is `hold(8497)`.
//
// That is the whole design for the three whole units: the literal is an ordinary
// integer count of seconds, so there is no duration type for the parser or the code
// generator to know about, and a duration composes in arithmetic like anything else.
// Printing one shows the seconds, which is deliberate -- it is what makes `hold(2h)`
// and `hold(7200)` visibly the same call.
//
// A literal with a sub-second part is the one exception, and it is an ordinary float
// of seconds rather than a third representation of its own. There is no integer to
// give for half a second, so `500ms` is 0.5 and `hold` takes a number either way.
// `1m500ms` is 60.5 rather than 1500 of something: the sub-second unit means
// milliseconds, so the literal is not a count of milliseconds and never was.
//
// This test prints every spelling rather than waiting for it. The waits are all
// short except for a single `hold(1)`, because a golden case that slept for real
// would add its duration to every run of the suite at every optimization level,
// and the literals are the part with the interesting edges. The one second is here
// so that the runtime call is exercised end to end rather than only its argument
// checking.

int main() {
    // The units on their own.
    Console.WriteLog(2h);      // 7200
    Console.WriteLog(21m);     // 1260
    Console.WriteLog(37s);     // 37
    Console.WriteLog(37);      // 37: a bare number is seconds, and still the integer 37

    // Run together, which is the spelling the builtin exists for.
    Console.WriteLog(2h21m37); // 7200 + 1260 + 37
    Console.WriteLog(1h30m);   // 5400
    Console.WriteLog(59s);     // 59
    Console.WriteLog(60m);     // 3600, not 60: the unit decides
    Console.WriteLog(24h);     // 86400
    Console.WriteLog(1h0m0s);  // 3600, and every part of it is written out
    Console.WriteLog(0h0m0);   // 0

    // Upper case is accepted, since `0X` and `1E3` are.
    Console.WriteLog(1H);
    Console.WriteLog(1M);
    Console.WriteLog(1S);

    // Underscores separate digits inside a component, as they do in any number.
    Console.WriteLog(1_000s);
    Console.WriteLog(2h1_0m);

    // A duration of whole seconds is an integer, so it is an ordinary operand.
    Console.WriteLog(2h + 1);
    Console.WriteLog(1h / 1m);   // 60
    var d = 2h21m37;
    Console.WriteLog(d);

    // The sub-second units. These are the only literals that are not integers,
    // and they print as the float of seconds they are.
    Console.WriteLog(500ms);     // 0.5
    Console.WriteLog(1500ms);    // 1.5
    Console.WriteLog(1000ms);    // 1 -- a whole second, reached from below
    Console.WriteLog(250us);     // 0.00025
    Console.WriteLog(0ms);       // 0

    // A sub-second part runs together with the whole ones the same way.
    Console.WriteLog(1m500ms);   // 60.5
    Console.WriteLog(0h0m0s250ms);

    // Upper case and underscores work here too.
    Console.WriteLog(500MS);
    Console.WriteLog(250US);
    Console.WriteLog(1_500ms);

    // And it is an ordinary operand in the same way, so a fractional wait can be
    // computed rather than only spelled.
    Console.WriteLog(500ms + 1);   // 1.5
    Console.WriteLog(1ms * 1000);  // 1
    Console.WriteLog(500ms / 2);   // 0.25

    // Zero waits return at once, in every spelling.
    hold(0);
    hold(0s);
    hold(0h0m0);
    hold(0h0m0s);
    hold(0ms);
    Console.WriteLog("held zero");

    // So do the values that are not a length of time at all. A NaN and an
    // infinity are both what dividing by a zero that was not meant to be one
    // leaves behind, and neither is a wait: an infinity in particular must not be
    // mistaken for the longest one, or this line would hang rather than return.
    var zero = 0.0;
    hold(zero / zero);
    hold(1.0 / zero);
    hold(-1.5);
    Console.WriteLog("held nothing");

    // Sub-second waits, which take the floating-point entry point.
    hold(1ms);
    hold(250us);
    Console.WriteLog("held under a second");

    // One real second, so the whole-second runtime call itself is covered too. It
    // is the only thing in this file that takes any real time.
    hold(1);
    Console.WriteLog("held one second");
    return 0;
}