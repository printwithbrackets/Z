int main() {
    // constant expressions fold at compile time; results must be correct
    print(2 + 3 * 4);
    print((5 - 1) * 2);
    print(100 / 5 + 100 % 7);
    print(-7 + 2);
    print(!(true && false));
    print(3 < 4);
    print(10 > 20);
    var s = 0;
    s += 2 + 3 * 4;
    s += (1 < 2) ? 1 : 0;
    print(s);
    return 0;
}
