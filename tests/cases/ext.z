int Twice(this int n) { return n * 2; }
int Add(this int a, int b) { return a + b; }
string Shout(this string s) { return s + "!"; }

int main() {
    Console.WriteLog(5.Twice());
    Console.WriteLog(7.Add(3));
    Console.WriteLog("hi".Shout());
    Console.WriteLog(10.Twice() + 1.Twice());
    return 0;
}
