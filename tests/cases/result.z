// Result<T, E>: a value that is either an Ok carrying a T or an Err carrying an
// E, and the `?` operator that propagates the error case out of a function.
//
// `Result` is a union with two variants, so `match` handles it and the
// exhaustiveness check applies: an arm for each of Ok and Err, or a `_`.

Result<int, string> parse(string s) {
    if (s == "42") { return Ok(42); }
    return Err("not a number: " + s);
}

// A different T, the same E: `?` yields the int and the string flows through.
Result<bool, string> positive(string s) {
    var n = parse(s)?;
    return Ok(n > 0);
}

Result<int, string> twice(string s) {
    var v = parse(s)?;
    return Ok(v * 2);
}

// Two calls, both propagating.
Result<int, string> sum(string a, string b) {
    var x = parse(a)?;
    var y = parse(b)?;
    return Ok(x + y);
}

// A function that returns a Result but never fails.
Result<int, string> constant() {
    return Ok(7);
}

int main() {
    // ---- the Ok and Err cases ----
    Console.WriteLog(match parse("42") { Ok(v) => v, Err(_) => -1 });
    Console.WriteLog(match parse("x") { Ok(_) => 0, Err(_) => 1 } + 0);
    Console.WriteLog(match parse("x") { Ok(_) => "ok", Err(e) => e });

    // ---- `?` yields the payload ----
    Console.WriteLog(match positive("42") { Ok(v) => v ? 1 : 0, Err(_) => -1 });
    Console.WriteLog(match positive("nope") { Ok(_) => 0, Err(_) => 1 } + 0);
    Console.WriteLog(match positive("nope") { Ok(_) => "unexpected", Err(e) => e });

    // ---- `?` in a chain, and a function that cannot fail ----
    Console.WriteLog(match twice("42") { Ok(v) => v, Err(_) => -1 });
    Console.WriteLog(match sum("42", "42") { Ok(v) => v, Err(_) => -1 });
    Console.WriteLog(match sum("42", "x") { Ok(_) => 0, Err(_) => 1 } + 0);
    Console.WriteLog(match constant() { Ok(v) => v, Err(_) => -1 });

    // ---- the error value is the whole point: nothing was thrown ----
    // The error text names the input, so the caller can act on it.
    var bad = match parse("hello") { Ok(_) => "", Err(e) => e };
    Console.WriteLog(bad);

    // ---- `?` on a Result held in a variable, not a call ----
    var held = parse("42");
    Console.WriteLog(match held { Ok(v) => v, Err(_) => -1 });

    // ---- a float payload ----
    Console.WriteLog(match half("nope") { Ok(v) => v * 100.0, Err(_) => -1.0 });
    Console.WriteLog(match half("42") { Ok(v) => v * 100.0, Err(_) => -1.0 });

    // ---- a pointer payload ----
    // A struct by value does not fit in one word, so a Result cannot carry one;
    // a pointer to it can. The diagnostic says so rather than truncating.
    Console.WriteLog(match first("nope") { Ok(_) => 0, Err(_) => 1 } + 0);
    Console.WriteLog(match first("42") { Ok(v) => v.x, Err(_) => -1 });

    resultMethods();
    return 0;
}

Result<float, string> half(string s) {
    var n = parse(s)?;
    return Ok((float)n / 2.0);
}

struct Pt { int x; int y; }
Result<Pt*, string> first(string s) {
    var n = parse(s)?;
    var pt = new Pt(n, 0);
    var p = &pt;
    return Ok(p);
}

/* A method returning a Result, with parameters.
 *
 * This is the shape the file API is made of, and it did not work: the parameter
 * types a caller is checked against were read one slot to the left, so the
 * receiver was reported as the first parameter. `argument 1 of 'w' expects 'F*'
 * but got 'int'` for a method taking an int.
 *
 * The cause was the hidden result buffer. Anything returned through memory gets
 * one pushed in front of the parameters, and the offset was computed by asking
 * whether the return type is a struct. `Result` is a two-variant union, so the
 * answer was no and the offset was one short. A Result-returning method with *no*
 * parameters was unaffected, which is why it went unnoticed: with nothing to
 * misalign, there was nothing to report. */
class Source {
    string text;
    Source(string t) { this.text = t; }

    /* Result, one parameter. */
    Result<int, string> count() {
        return Ok(len(this.text));
    }

    /* Result, two parameters of different types, so a shifted table cannot
     * accidentally line up. */
    Result<string, string> slice(int start, int count) {
        if (start + count > len(this.text)) {
            return Err("out of range");
        }
        return Ok(this.text[start..start + count]);
    }

    /* A plain int return alongside them, because the fix must not have changed
     * the shape that already worked. */
    int size() { return len(this.text); }

    /* A method returning a struct, which is the other sret case. */
    Boxed boxed(int n) { return new Boxed(n, "b"); }
}

struct Boxed { int n; string tag; }

/* Driven from the file's own main. */
void resultMethods() {
    var s = new Source("hello world");

    match (s.count()) {
        Ok(n) => Console.WriteLog(int_to_string(n)),
        Err(e) => Console.WriteLog("err " + e),
    };
    match (s.slice(0, 5)) {
        Ok(part) => Console.WriteLog(part),
        Err(e) => Console.WriteLog("err " + e),
    };
    match (s.slice(8, 99)) {
        Ok(part) => Console.WriteLog(part),
        Err(e) => Console.WriteLog("err " + e),
    };
    Console.WriteLog(int_to_string(s.size()));

    var b = s.boxed(7);
    Console.WriteLog(int_to_string(b.n));
    Console.WriteLog(b.tag);
}
