// Result<T, E>: a value that is either an Ok carrying a T or an Err carrying an
// E, and the `?` operator that propagates the error case out of a function.
//
// `Result` is a union with two variants, so `match` handles it and the
// exhaustiveness check applies: an arm for each of Ok and Err, or a `_`.

Result<int, string> parse(string s) {
    if (s == "42") { return Ok(42); }
    return Err("not a number: " + s);
}

// A different T, the same E: `?` yields the int and the string flows through.
Result<bool, string> positive(string s) {
    var n = parse(s)?;
    return Ok(n > 0);
}

Result<int, string> twice(string s) {
    var v = parse(s)?;
    return Ok(v * 2);
}

// Two calls, both propagating.
Result<int, string> sum(string a, string b) {
    var x = parse(a)?;
    var y = parse(b)?;
    return Ok(x + y);
}

// A function that returns a Result but never fails.
Result<int, string> constant() {
    return Ok(7);
}

int main() {
    // ---- the Ok and Err cases ----
    print(match parse("42") { Ok(v) => v, Err(_) => -1 });
    print(match parse("x") { Ok(_) => 0, Err(_) => 1 } + 0);
    print(match parse("x") { Ok(_) => "ok", Err(e) => e });

    // ---- `?` yields the payload ----
    print(match positive("42") { Ok(v) => v ? 1 : 0, Err(_) => -1 });
    print(match positive("nope") { Ok(_) => 0, Err(_) => 1 } + 0);
    print(match positive("nope") { Ok(_) => "unexpected", Err(e) => e });

    // ---- `?` in a chain, and a function that cannot fail ----
    print(match twice("42") { Ok(v) => v, Err(_) => -1 });
    print(match sum("42", "42") { Ok(v) => v, Err(_) => -1 });
    print(match sum("42", "x") { Ok(_) => 0, Err(_) => 1 } + 0);
    print(match constant() { Ok(v) => v, Err(_) => -1 });

    // ---- the error value is the whole point: nothing was thrown ----
    // The error text names the input, so the caller can act on it.
    var bad = match parse("hello") { Ok(_) => "", Err(e) => e };
    print(bad);

    // ---- `?` on a Result held in a variable, not a call ----
    var held = parse("42");
    print(match held { Ok(v) => v, Err(_) => -1 });

    // ---- a float payload ----
    print(match half("nope") { Ok(v) => v * 100.0, Err(_) => -1.0 });
    print(match half("42") { Ok(v) => v * 100.0, Err(_) => -1.0 });

    // ---- a pointer payload ----
    // A struct by value does not fit in one word, so a Result cannot carry one;
    // a pointer to it can. The diagnostic says so rather than truncating.
    print(match first("nope") { Ok(_) => 0, Err(_) => 1 } + 0);
    print(match first("42") { Ok(v) => v.x, Err(_) => -1 });

    return 0;
}

Result<float, string> half(string s) {
    var n = parse(s)?;
    return Ok((float)n / 2.0);
}

struct Pt { int x; int y; }
Result<Pt*, string> first(string s) {
    var n = parse(s)?;
    var pt = new Pt(n, 0);
    var p = &pt;
    return Ok(p);
}
