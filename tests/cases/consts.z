// const: a named compile-time constant. It occupies no frame slot -- a
// reference is replaced by the literal while parsing -- so consts are free to
// use in hot code. Initializers may be constant expressions over other
// consts, and a const must be declared before use (like types, and unlike
// functions, whose signatures are pre-scanned).
const int MAX = 100;
const int HALF = MAX / 2;
const int FLAGS = 1 | 2 | 4;
const int SHIFTED = 1 << 10;
const int MASKED = FLAGS & 6;
const int NEG = -7;
const int WRAPPED = 1 << 40;
const bool ON = true;
const bool OFF = false;
const string NAME = "z";
const int F_ALIVE = 1;
const int F_ELITE = 4;

int describe(int flags) {
    if ((flags & F_ALIVE) != 0 && (flags & F_ELITE) == 0) { return 1; }
    if ((flags & F_ELITE) != 0) { return 3; }
    return 0;
}

int scaled(int n) { return n * MAX + HALF; }

int main() {
    Console.WriteLog(MAX);        // 100
    Console.WriteLog(HALF);       // 50
    Console.WriteLog(FLAGS);      // 7
    Console.WriteLog(SHIFTED);    // 1024
    Console.WriteLog(MASKED);     // 6
    Console.WriteLog(NEG);        // -7
    Console.WriteLog(WRAPPED);    // 1099511627776
    Console.WriteLog(ON);         // true
    Console.WriteLog(OFF);        // false
    Console.WriteLog(NAME);       // z
    Console.WriteLog(scaled(2));  // 250

    Console.WriteLog(describe(F_ALIVE));                    // 1
    Console.WriteLog(describe(F_ALIVE | F_ELITE));          // 3
    Console.WriteLog(describe(F_ELITE));                    // 3

    /* A const works anywhere a literal does, including array sizes. */
    var a = new int[MAX / 50];
    a[0] = HALF;
    Console.WriteLog(a[0]);        // 50
    Console.WriteLog(a.length);    // 2

    /* And consts are compile-time constant, so they fold. */
    Console.WriteLog(MAX / 4 + 1); // 26
    return 0;
}
