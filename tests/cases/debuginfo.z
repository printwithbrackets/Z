// Compiled with -g, so the output doubles as a check that emitting debug info
// does not change what the program does.
int scale(int v, int factor) {
    return v * factor;
}

int combine(int a, int b, int c) {
    // Locals, so that a -O0 build has something a debugger should be able to
    // name. At -O0 every local lives in its frame slot and has an address, so
    // both of these belong in the debug info; above -O0 they are promoted to
    // registers and have none, which is a separate gap.
    var sum = a + b;
    var total = sum + c;
    return total;
}

float twice(float v) { return v * 2.0; }

int main() {
    Console.WriteLog(scale(6, 7));
    Console.WriteLog(combine(1, 2, 3));
    Console.WriteLog(twice(1.5));
    Console.WriteLog("debug info: ok");
    return 0;
}
