// Compiled with -g, so the output doubles as a check that emitting debug info
// does not change what the program does.
int scale(int v, int factor) {
    return v * factor;
}

int combine(int a, int b, int c) {
    return a + b + c;
}

float twice(float v) { return v * 2.0; }

int main() {
    print(scale(6, 7));
    print(combine(1, 2, 3));
    print(twice(1.5));
    print("debug info: ok");
    return 0;
}
