// Destructors: `~Type() { ... }` runs when a value's scope ends.
//
// Z has no `delete`. A value is destroyed by its scope ending, which is checked
// rather than remembered and cannot be spelled wrong. Order is reverse
// declaration order, and it runs on *every* way out of the scope, not just
// falling off the end -- which is the whole reason this is worth having over a
// `free` the programmer has to remember to call before each of five exits.
class Tracked {
    int id;
    Tracked(int v) { this.id = v; }
    ~Tracked() {
        print("drop");
        print(this.id);
    }
}

// A destructor reads a field of the object, so this also checks the receiver is
// the object rather than a frame slot that happens to hold it.

int main() {
    // Normal exit: drops run in reverse declaration order, 3 then 2 then 1.
    {
        var a = new Tracked(1);
        var b = new Tracked(2);
        var c = new Tracked(3);
        print("in scope");
    }
    print("left scope");

    // A type with no destructor costs nothing to declare and nothing to run.
    {
        var x = 5;
        print(x);
        var y = "hello";
        print(y);
    }

    // Nested scopes drop innermost first.
    {
        var outer = new Tracked(4);
        {
            var inner = new Tracked(5);
            print("inner scope");
        }
        print("outer still live");
    }
    print("nested done");

    // A function that returns still destroys what it owns. This is the case a
    // `free` the programmer has to remember gets wrong: there are five exits
    // from a function and the one you forget is the one that leaks.
    print("calling makeOne");
    var made = makeOne();
    print("made");
    print(made.id);

    // A `return` from inside a nested scope destroys both scopes' values, inner
    // first.
    var got = early(9);
    print(got);

    // A loop that runs to completion drops each iteration's value as it ends,
    // rather than all of them at the end of the function.
    for (var i = 1; i <= 2; i = i + 1) {
        var scoped = new Tracked(100 + i);
    }
    print("loop done");

    // `break` leaves the loop, so the values the iteration owns go with it.
    for (var j = 1; j <= 5; j = j + 1) {
        var earlyExit = new Tracked(200 + j);
        if (j == 2) { break; }
    }
    print("break done");

    print("end of main");
    jumpUser();
    tryUser();
    return 0;
}

Tracked* makeOne() {
    var local = new Tracked(6);
    return new Tracked(7);
}

int early(int v) {
    var kept = new Tracked(v);
    {
        var inner = new Tracked(v + 1);
    }
    return v + 100;
}

/* `break` and `continue` destroy what the iteration owns.
 *
 * A jump out of a scope is an exit from it like any other, and the values that
 * scope owns have to go with it. This used to be a diagnostic that said `?`,
 * `break` and `continue` did not unwind; they do now.
 *
 * The loop's own body scope is destroyed by the jump, because a break does leave
 * it. Whatever the loop was written *inside* survives, which is the part that was
 * easy to get wrong: the floor for the walk is the scope enclosing the loop, and
 * resolving it after the fact rather than where the jump was written makes the
 * walk run to the top of the function and destroys the caller's locals too.
 */
int jumps(int which) {
    for (var i = 0; i < 3; i = i + 1) {
        var owned = new Tracked(300 + i);
        if (i == 1) {
            if (which == 0) { break; }
            continue;
        }
        print("kept " + int_to_string(owned.id));
    }
    return 0;
}

int jumpUser() {
    print("before");
    jumps(0);
    print("after break");
    jumps(1);
    print("after continue");
    return 0;
}

/* `?` unwinds too.
 *
 * The early return a `?` takes on an Err jumps straight to the epilogue, so
 * without this it skipped the teardown a `return` gets, and a function that owns
 * a value leaked it every time the error arm was taken -- not once per run, but
 * once per failure, which is the shape that hides longest.
 *
 * The drop list is built where the `?` is written rather than in the destructor
 * pass, and the third case below is why. `late` is declared *after* the `?`, so on
 * the path the `?` takes it has never been initialised; a list built by the pass
 * would include it and run its destructor on an uninitialised slot. This case is
 * the only thing that catches that, and it catches it as a crash rather than a
 * diff.
 */
/* Not a constant Err on purpose: a `tryFail` that always failed makes the compiler
 * prove every `?` below unreachable, and then the dead `print`s are reported as
 * warnings and the locals they were keeping alive go unused. */
Result<int, string> tryFail(bool fail) {
    var inner = new Tracked(400);
    if (fail) { return Err("no"); }
    return Ok(7);
}

string describeTry(Result<int, string> r) {
    return match (r) {
        Ok(v) => "ok " + int_to_string(v),
        Err(e) => "err " + e,
    };
}

Result<int, string> tryOwner() {
    var owned = new Tracked(401);
    var v = tryFail(true)?;
    print("unreachable " + int_to_string(v));
    return Ok(v);
}

Result<int, string> tryOwnerNested() {
    var outer = new Tracked(402);
    if (true) {
        var inner = new Tracked(403);
        var v = tryFail(true)?;
        print("unreachable " + int_to_string(v));
    }
    return Ok(0);
}

Result<int, string> tryLaterLocal() {
    var v = tryFail(true)?;
    var late = new Tracked(404);
    print("unreachable " + int_to_string(v));
    return Ok(v);
}

int tryUser() {
    print("try " + describeTry(tryOwner()));
    print("try " + describeTry(tryOwnerNested()));
    print("try " + describeTry(tryLaterLocal()));
    return 0;
}
