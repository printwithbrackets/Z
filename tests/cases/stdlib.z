// The standard library the compiler provides without a declaration: the string
// operations, and the integer operations that need no floating point.

// len, and the ASCII case mappings.
print(len(""));                    // 0
print(len("hello"));               // 5
print(len("\x41\x42"));            // 2
print(upper("Hello, World!"));     // HELLO, WORLD!
print(lower("Hello, World!"));     // hello, world!
print(upper("\xc3\xa9"));           // the non-ASCII byte is left alone

// trim strips ASCII whitespace from both ends and nothing else.
print(trim("  \t hello \n ") == "hello");  // true
var trimmed = trim("  \t hello \n ");
print($"[{trimmed}]");              // [hello]
print(trim(""));                   //
print(trim("   "));                //

// sub clamps rather than trapping, and a negative start counts from the end.
print(sub("abcdef", 0, 3));        // abc
print(sub("abcdef", 3, 3));        // def
print(sub("abcdef", 2, 99));       // cdef   (clamped at the end)
print(sub("abcdef", 99, 3));       //         (clamped at the start)
print(sub("abcdef", 0, 0));        //
print(sub("abcdef", -2, 2));       // ef
print(sub("abcdef", -99, 2));      // ab     (clamped at the start)
print(sub("abcdef", 1, -5));       //         (a negative count is empty)

// Searching. index_of is a byte offset, or -1.
print(index_of("abcdef", "cd"));   // 2
print(index_of("abcdef", "a"));    // 0
print(index_of("abcdef", "f"));    // 5
print(index_of("abcdef", "zz"));   // -1
print(index_of("abc", ""));        // 0
print(contains("abcdef", "cd"));   // true
print(contains("abcdef", "zz"));   // false
print(starts_with("abcdef", "abc"));  // true
print(starts_with("abcdef", "bc"));   // false
print(starts_with("abc", ""));        // true
print(ends_with("abcdef", "def"));    // true
print(ends_with("abcdef", "de"));     // false
print(ends_with("abc", ""));          // true

// char_at returns a byte value, zero-extended, and -1 past the end so a caller
// walking to the end can tell it happened.
print(char_at("abc", 0));          // 97
print(char_at("abc", 2));          // 99
print(char_at("abc", -1));         // -1
print(char_at("abc", 3));          // -1
print(char_at("\xff", 0));         // 255

// replace rewrites every occurrence; an empty needle changes nothing.
print(replace("a-b-c", "-", "=")); // a=b=c
print(replace("aaa", "a", "aa"));  // aaaaaa
print(replace("abc", "x", "y"));   // abc
print(replace("abc", "", "y"));    // abc
print(replace("hello", "l", ""));  // heo

print(repeat("ab", 0));            //
print(repeat("ab", 3));            // ababab

// split returns a real string[], so .length and foreach work on it directly.
var parts = split("a,b,c", ",");
print(parts.length);               // 3
print(parts[0]);                   // a
print(parts[2]);                   // c
foreach (var p in parts) {
    print(p);
}

var one = split("solo", ",");
print(one.length);                 // 1
print(one[0]);                     // solo

// No trailing empty piece, matching every other split.
var trailing = split("a,", ",");
print(trailing.length);            // 1

// An empty separator splits into single characters. An empty string splits into
// the one empty piece, which is what Python, Java and Go all do -- "there is a
// separator-free string here, and it is empty" -- and a trailing separator never
// produces a trailing empty piece.
var chars = split("abc", "");
print(chars.length);               // 3
print(chars[1]);                   // b
var nothing = split("", ",");
print(nothing.length);             // 1
print($"[{nothing[0]}]");          // []

// Interior empty pieces are kept, so the split lines up with the source.
var dbl = split("a,,b", ",");
print(dbl.length);                 // 3
print($"[{dbl[1]}]");              // []

// Results compose with the rest of the language: real types, real operators.
print(len(trim("  ab  ")) + 1);    // 3
var upper_sum = 0;
foreach (var w in split("a,bb,ccc", ",")) {
    upper_sum = upper_sum + len(w);
}
print(upper_sum);                  // 6
print(trim(upper("  hi  ")));      // HI

// The integer library.
print(pow(2, 10));                 // 1024
print(pow(2, 0));                  // 1
print(pow(5, 1));                  // 5
print(pow(2, 3));                  // 8
print(pow(7, 0));                  // 1
print(pow(3, -2));                 // 0    (no integer answer for a negative power)
print(gcd(12, 18));                // 6
print(gcd(17, 5));                 // 1
print(gcd(0, 9));                  // 9
print(gcd(-12, 18));               // 6    (sign-insensitive)
print(lcm(4, 6));                  // 12
print(lcm(3, 7));                  // 21
print(lcm(0, 5));                  // 0
