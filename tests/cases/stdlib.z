// The standard library the compiler provides without a declaration: the string
// operations, and the integer operations that need no floating point.

// len, and the ASCII case mappings.
Console.WriteLog(len(""));                    // 0
Console.WriteLog(len("hello"));               // 5
Console.WriteLog(len("\x41\x42"));            // 2
Console.WriteLog(upper("Hello, World!"));     // HELLO, WORLD!
Console.WriteLog(lower("Hello, World!"));     // hello, world!
Console.WriteLog(upper("\xc3\xa9"));           // the non-ASCII byte is left alone

// trim strips ASCII whitespace from both ends and nothing else.
Console.WriteLog(trim("  \t hello \n ") == "hello");  // true
var trimmed = trim("  \t hello \n ");
Console.WriteLog($"[{trimmed}]");              // [hello]
Console.WriteLog(trim(""));                   //
Console.WriteLog(trim("   "));                //

// sub clamps rather than trapping, and a negative start counts from the end.
Console.WriteLog(sub("abcdef", 0, 3));        // abc
Console.WriteLog(sub("abcdef", 3, 3));        // def
Console.WriteLog(sub("abcdef", 2, 99));       // cdef   (clamped at the end)
Console.WriteLog(sub("abcdef", 99, 3));       //         (clamped at the start)
Console.WriteLog(sub("abcdef", 0, 0));        //
Console.WriteLog(sub("abcdef", -2, 2));       // ef
Console.WriteLog(sub("abcdef", -99, 2));      // ab     (clamped at the start)
Console.WriteLog(sub("abcdef", 1, -5));       //         (a negative count is empty)

// Searching. index_of is a byte offset, or -1.
Console.WriteLog(index_of("abcdef", "cd"));   // 2
Console.WriteLog(index_of("abcdef", "a"));    // 0
Console.WriteLog(index_of("abcdef", "f"));    // 5
Console.WriteLog(index_of("abcdef", "zz"));   // -1
Console.WriteLog(index_of("abc", ""));        // 0
Console.WriteLog(contains("abcdef", "cd"));   // true
Console.WriteLog(contains("abcdef", "zz"));   // false
Console.WriteLog(starts_with("abcdef", "abc"));  // true
Console.WriteLog(starts_with("abcdef", "bc"));   // false
Console.WriteLog(starts_with("abc", ""));        // true
Console.WriteLog(ends_with("abcdef", "def"));    // true
Console.WriteLog(ends_with("abcdef", "de"));     // false
Console.WriteLog(ends_with("abc", ""));          // true

// char_at returns a byte value, zero-extended, and -1 past the end so a caller
// walking to the end can tell it happened.
Console.WriteLog(char_at("abc", 0));          // 97
Console.WriteLog(char_at("abc", 2));          // 99
Console.WriteLog(char_at("abc", -1));         // -1
Console.WriteLog(char_at("abc", 3));          // -1
Console.WriteLog(char_at("\xff", 0));         // 255

// replace rewrites every occurrence; an empty needle changes nothing.
Console.WriteLog(replace("a-b-c", "-", "=")); // a=b=c
Console.WriteLog(replace("aaa", "a", "aa"));  // aaaaaa
Console.WriteLog(replace("abc", "x", "y"));   // abc
Console.WriteLog(replace("abc", "", "y"));    // abc
Console.WriteLog(replace("hello", "l", ""));  // heo

Console.WriteLog(repeat("ab", 0));            //
Console.WriteLog(repeat("ab", 3));            // ababab

// split returns a real string[], so .length and foreach work on it directly.
var parts = split("a,b,c", ",");
Console.WriteLog(parts.length);               // 3
Console.WriteLog(parts[0]);                   // a
Console.WriteLog(parts[2]);                   // c
foreach (var p in parts) {
    Console.WriteLog(p);
}

var one = split("solo", ",");
Console.WriteLog(one.length);                 // 1
Console.WriteLog(one[0]);                     // solo

// No trailing empty piece, matching every other split.
var trailing = split("a,", ",");
Console.WriteLog(trailing.length);            // 1

// An empty separator splits into single characters. An empty string splits into
// the one empty piece, which is what Python, Java and Go all do -- "there is a
// separator-free string here, and it is empty" -- and a trailing separator never
// produces a trailing empty piece.
var chars = split("abc", "");
Console.WriteLog(chars.length);               // 3
Console.WriteLog(chars[1]);                   // b
var nothing = split("", ",");
Console.WriteLog(nothing.length);             // 1
Console.WriteLog($"[{nothing[0]}]");          // []

// Interior empty pieces are kept, so the split lines up with the source.
var dbl = split("a,,b", ",");
Console.WriteLog(dbl.length);                 // 3
Console.WriteLog($"[{dbl[1]}]");              // []

// Results compose with the rest of the language: real types, real operators.
Console.WriteLog(len(trim("  ab  ")) + 1);    // 3
var upper_sum = 0;
foreach (var w in split("a,bb,ccc", ",")) {
    upper_sum = upper_sum + len(w);
}
Console.WriteLog(upper_sum);                  // 6
Console.WriteLog(trim(upper("  hi  ")));      // HI

// The integer library.
Console.WriteLog(pow(2, 10));                 // 1024
Console.WriteLog(pow(2, 0));                  // 1
Console.WriteLog(pow(5, 1));                  // 5
Console.WriteLog(pow(2, 3));                  // 8
Console.WriteLog(pow(7, 0));                  // 1
Console.WriteLog(pow(3, -2));                 // 0    (no integer answer for a negative power)
Console.WriteLog(gcd(12, 18));                // 6
Console.WriteLog(gcd(17, 5));                 // 1
Console.WriteLog(gcd(0, 9));                  // 9
Console.WriteLog(gcd(-12, 18));               // 6    (sign-insensitive)
Console.WriteLog(lcm(4, 6));                  // 12
Console.WriteLog(lcm(3, 7));                  // 21
Console.WriteLog(lcm(0, 5));                  // 0
