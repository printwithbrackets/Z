// bool renders as true/false in string concat and interpolation
int main() {
    var t = true;
    var f = false;
    Console.WriteLog("t=" + t + " f=" + f);
    Console.WriteLog($"inline {t} and {f} and {1 == 1} and {1 == 2}");
    Console.WriteLog("num still works: " + 42 + " bool: " + t);
    return 0;
}
