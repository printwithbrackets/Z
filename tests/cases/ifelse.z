var n = 15;
if (n > 10) {
    Console.WriteLog("big");
} else {
    Console.WriteLog("small");
}
if (n < 10) {
    Console.WriteLog("nope");
} else if (n == 15) {
    Console.WriteLog("fifteen");
} else {
    Console.WriteLog("other");
}
if (n > 100) {
    Console.WriteLog("huge");
}
Console.WriteLog("done");
