// Bound method pointers. `&obj.M` yields a callable with the receiver already
// bound, typed by a `method(params) -> ret` annotation where a type is needed.
// The value is a pointer to a GC-managed { code, receiver } cell, so the
// receiver stays alive exactly as long as the pointer does.
class Counter {
    int n;
    Counter(int a) { n = a; }
    int get() { return n; }
    int add(int x) { return n + x; }
    int mul(int x) { return n * x; }
    void bump(int by) { n = n + by; return; }
    virtual int v() { return 1; }
}

// A second class rather than a subclass. There is no base type to store it in,
// so the two are related only by each having a `v`, and `Sub`'s is its own.
class Sub {
    int n;
    Sub(int a) { n = a; }
    int get() { return n; }
    int add(int x) { return n + x; }
    virtual int v() { return 2; }
}

void take(method(int) -> int g) { Console.WriteLog(g(10)); return; }

int main() {
    var c = new Counter(5);
    var m = &c.add;
    Console.WriteLog(m(3));                       // 8
    Console.WriteLog(c.add(3));                   // 8   a direct call is unaffected

    var g = &c.get;
    Console.WriteLog(g());                        // 5   no arguments
    var mu = &c.mul;
    Console.WriteLog(mu(4));                      // 20

    /* the receiver is bound now, so later mutation shows through */
    c.bump(10);
    Console.WriteLog(m(0));                       // 15
    Console.WriteLog(g());                        // 15

    /* two bindings to different methods of the same object coexist */
    Console.WriteLog(m(1) + mu(2));               // 16 + 30 = 46

    /* passed as a parameter, and stored in an array */
    take(&c.add);                      // 25  (n is 15 by now, so +10)
    var arr = new method(int) -> int[2];
    arr[0] = &c.add; arr[1] = &c.mul;
    Console.WriteLog(arr[0](1) + arr[1](2));      // 46

    /* a virtual method dispatches on the runtime type, not the static one */
    var s = new Sub(7);
    var sv = &s.v;
    Console.WriteLog(sv());                       // 2
    var cv = &c.v;
    Console.WriteLog(cv());                       // 1 -- Counter's own v, not Sub's

    /* the receiver is reachable only from the binding, so the collector has to
     * trace the cell rather than free the object out from under it */
    var km = keep();
    Console.WriteLog(churn(20000) > 0 ? 1 : 0);    // 1
    Console.WriteLog(km(1));                      // 8
    Console.WriteLog(km(2));                      // 9
    return 0;
}

/* Returns a binding whose receiver is the only reference to the object. */
method(int) -> int keep() {
    var b = new Counter(7);
    return &b.add;
}

/* Allocates enough garbage to force several collections. */
int churn(int n) {
    var s = 0;
    for (var i = 0; i < n; i = i + 1) {
        var junk = new int[64];
        junk[0] = i;
        s = s + junk[0];
    }
    return s;
}
