// Cross-feature integration: classes (vtables/ctors) + generics + structs +
// enums + operator overloading + control flow + GC together. Exercises the
// register allocator with many live values (incl. class objects) at once.
// An interface, not a base class: Dog and Cat are not subtypes of anything, and
// what collects them into one array is that both answer Speak and Id.
interface Animal {
    string Speak();
    int Id();
}
class Dog {
    int id;
    string name;
    Dog(int i, string n) { this.id = i; this.name = n; }
    virtual string Speak() { return this.name + " woof"; }
    virtual int Id() { return this.id; }
}
class Cat {
    int id;
    Cat(int i) { this.id = i; }
    virtual string Speak() { return "meow"; }
    virtual int Id() { return this.id; }
}
struct Vec { int x; int y; Vec op_Add(Vec* o) => new Vec(x + o.x, y + o.y); }
enum Op { Add(int a, int b), Mul(int a, int b), Neg(int a) }
int apply(Op o) => match o { Add(x, y) => x + y, Mul(m, n) => m * n, Neg(z) => 0 - z };
T maxOf<T>(T a, T b) { if (a > b) { return a; } return b; }

int main() {
    var v1 = 10; var v2 = 20; var v3 = 30; var v4 = 40; var v5 = 50;
    var d = new Dog(1, "Rex");
    var c = new Cat(2);
    var animals = new Animal[2];
    animals[0] = d; animals[1] = c;
    var p = new Vec(1, 2); var q = new Vec(3, 4);
    var r = p + q;
    Console.WriteLog(animals[0].Speak() + "/" + animals[1].Speak());  // Rex woof/meow
    Console.WriteLog(animals[0].Id() + " " + animals[1].Id());        // 1 2
    Console.WriteLog("v " + r.x + "," + r.y);                          // v 4,6
    Console.WriteLog(apply(Add(2, 3)) + " " + apply(Mul(4, 5)) + " " + apply(Neg(7)));
    Console.WriteLog(maxOf(v3, v4) + " " + maxOf(9, 2));               // 40 9
    var acc = 0;
    for (var i = 0; i < 50; i = i + 1) {
        if (i % 2 == 0) { acc = acc + d.Id() + i; } else { acc = acc - i; }
        if (acc > 20) { acc = acc % 17; }
    }
    Console.WriteLog("acc " + acc);
    return 0;
}
