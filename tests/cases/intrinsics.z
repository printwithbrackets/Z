// Built-in intrinsics: abs/min/max/clamp are inlined, sqrt calls the runtime.
// A user function of the same name shadows the intrinsic.
int min(int a, int b) { return a * b; }

int main() {
    Console.WriteLog(abs(0 - 7)); Console.WriteLog(abs(7)); Console.WriteLog(abs(0));            // 7 7 0
    Console.WriteLog(abs(0 - 9223372036854775807));                       // 9223372036854775807

    Console.WriteLog(min(3, 9)); Console.WriteLog(min(9, 3));                         // 3 3
    Console.WriteLog(max(3, 9)); Console.WriteLog(max(9, 3));                         // 9 9
    Console.WriteLog(min(0 - 5, 0 - 9));                                   // -9

    Console.WriteLog(clamp(15, 0, 10)); Console.WriteLog(clamp(0 - 5, 0, 10));       // 10 0
    Console.WriteLog(clamp(5, 0, 10)); Console.WriteLog(clamp(0, 0, 10));            // 5 0
    Console.WriteLog(clamp(0 - 5, 0 - 5, 10)); Console.WriteLog(clamp(20, 0 - 5, 10)); // -5 10

    Console.WriteLog(sqrt(0)); Console.WriteLog(sqrt(1)); Console.WriteLog(sqrt(2));             // 0 1 1
    Console.WriteLog(sqrt(3)); Console.WriteLog(sqrt(4)); Console.WriteLog(sqrt(15));            // 1 2 3
    Console.WriteLog(sqrt(16)); Console.WriteLog(sqrt(17));                           // 4 4
    Console.WriteLog(sqrt(1000000));                                       // 1000
    Console.WriteLog(sqrt(0 - 4));                                         // -4  (n < 2 returns n)

    /* usable inside expressions, not just as a top-level argument */
    Console.WriteLog(sqrt(9) + sqrt(16));                                  // 7
    var a = new int[3];
    a[0] = 4; a[1] = 9; a[2] = 16;
    var s = 0;
    foreach (v in a) { s = s + sqrt(v); }
    Console.WriteLog(s);                                                   // 2+3+4 = 9

    /* a declaration named `min` shadows the intrinsic */
    Console.WriteLog(min(3, 4));                                           // 12
    return 0;
}
