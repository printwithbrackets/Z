var x = 1;
{
    var x = 2;
    Console.WriteLog(x);
    {
        var x = 3;
        Console.WriteLog(x);
    }
    Console.WriteLog(x);
}
Console.WriteLog(x);

int scopeTest(int n) {
    var local = n;
    {
        var local = n * 2;
        Console.WriteLog(local);
    }
    return local;
}
Console.WriteLog(scopeTest(5));
