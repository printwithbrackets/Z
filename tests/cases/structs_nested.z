struct Point { int x; int y; }
struct Line { Point a; Point b; }

int main() {
    var l = new Line(new Point(1, 2), new Point(3, 4));
    Console.WriteLog(l.a.x);
    Console.WriteLog(l.a.y);
    Console.WriteLog(l.b.x);
    Console.WriteLog(l.b.y);

    // array of structs
    var pts = new Point[2];
    pts[0] = new Point(7, 8);
    pts[1] = new Point(9, 10);
    Console.WriteLog(pts[0].x);
    Console.WriteLog(pts[1].y);
    return 0;
}
