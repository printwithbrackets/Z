struct Account {
    int id;
    int balance;
    int Id { get; set; }
    int Deposit(int amount) { balance += amount; return balance; }
}

int main() {
    var a = new Account(0, 100);
    a.Id = 42;
    Console.WriteLog(a.Id);
    a.Id = 7;
    Console.WriteLog(a.Id);
    Console.WriteLog(a.Deposit(50));
    return 0;
}
