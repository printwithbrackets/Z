// Constant division/modulo strength reduction: divisors incl. primes needing a
// 65-bit magic, negatives, and edge cases. Must match truncating division.
int main() {
    Console.WriteLog(1000000000 / 1000000007); Console.WriteLog(1000000000 % 1000000007);
    Console.WriteLog(-1000000000 / 1000000007); Console.WriteLog(-1000000000 % 1000000007);
    Console.WriteLog(7 / 3); Console.WriteLog(7 % 3);
    Console.WriteLog(-7 / 3); Console.WriteLog(-7 % 3);
    Console.WriteLog(1 / 3); Console.WriteLog(1 % 3);
    Console.WriteLog(-1 / 3); Console.WriteLog(-1 % 3);
    Console.WriteLog(100 / 7); Console.WriteLog(100 % 7);
    Console.WriteLog(2 / 1000000007); Console.WriteLog(2 % 1000000007);
    Console.WriteLog(999999999 / 1000000007); Console.WriteLog(999999999 % 1000000007);
    Console.WriteLog(999999999999 / 1000000007); Console.WriteLog(999999999999 % 1000000007);
    Console.WriteLog(6442450941 / 2147483647); Console.WriteLog(6442450941 % 2147483647);
    Console.WriteLog(-7 / 2); Console.WriteLog(-7 % 2);
    Console.WriteLog(7 / -2); Console.WriteLog(7 % -2);
    Console.WriteLog(-1 / 1000000007); Console.WriteLog(-1 % 1000000007);
    Console.WriteLog(0 / 7); Console.WriteLog(0 % 7);
    Console.WriteLog(123456789 / 1000000007); Console.WriteLog(123456789 % 1000000007);
    Console.WriteLog(-123456789 / 1000000007); Console.WriteLog(-123456789 % 1000000007);
    Console.WriteLog(5 / 1000000000); Console.WriteLog(5 % 1000000000);
    Console.WriteLog(987654321098 / 99991); Console.WriteLog(987654321098 % 99991);
    Console.WriteLog(-50 / 3); Console.WriteLog(-50 % 3);
    Console.WriteLog(1000000006 / 1000000007); Console.WriteLog(1000000006 % 1000000007);
    return 0;
}
