// Numeric literals in every radix, digit separators, and escape sequences.

Console.WriteLog(0);            // 0
Console.WriteLog(255);           // 255
Console.WriteLog(0xff);          // 255
Console.WriteLog(0XFF);          // 255
Console.WriteLog(0b1010);        // 10
Console.WriteLog(0B1010);        // 10
Console.WriteLog(0o755);         // 493
Console.WriteLog(0O755);         // 493
Console.WriteLog(1_000_000);     // 1000000
Console.WriteLog(0xdead_beef);   // 3735928559

// 1 << 30 is the fixed-point full turn used by sin/cos.
Console.WriteLog(1 << 30);       // 1073741824
Console.WriteLog(0x40000000);    // 1073741824

// Byte escapes, and the NUL escape.
Console.WriteLog("\x41\x42\x43");    // ABC
Console.WriteLog("a\tb");            // a<TAB>b
Console.WriteLog("q\"q");            // q"q
Console.WriteLog("back\\slash");     // back\slash

// \uXXXX is a code point, encoded as UTF-8: e-acute is C3 A9.
Console.WriteLog("\u00e9");          // é

// \u escapes for characters that have named escapes still work.
Console.WriteLog("\u0041");          // A
Console.WriteLog("\n");              // a bare newline, via its own escape

// A hex escape can spell a brace without opening an interpolation hole.
Console.WriteLog($"\x7bnot a hole\x7d");    // {not a hole}
Console.WriteLog($"[{"a" + "b"}]");         // [ab]

// An escaped brace is literal text, so this interpolates nothing.
Console.WriteLog($"a\{1 + 1}c");            // a{1 + 1}c

// ...while an unescaped one is a hole.
var n = 7;
Console.WriteLog($"a{n}c");                 // a7c

// Interpolation nests, and quotes inside a hole are not the end of the string.
Console.WriteLog($"{ "in" + "ner" }");      // inner
Console.WriteLog($"{n > 3 ? "big" : "small"}");   // big
