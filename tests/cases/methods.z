struct Vec {
    int x;
    int y;
    int Sum() { return x + y; }
    int Scaled(int k) { return (x + y) * k; }
    int Mag2() => x * x + y * y;
    int Sum2() => x + y;
}

int twice(int n) => n * 2;

int main() {
    var v = new Vec(3, 4);
    print(v.Sum());
    print(v.Scaled(10));
    print(v.Mag2());
    print(v.Sum2());
    print(v.Sum() + v.Scaled(2));
    print(twice(21));
    return 0;
}
