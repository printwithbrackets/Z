// `auto` and `->`: the C++-flavored spellings added in v2 slice 1.
//
// `auto` is a synonym for `var`, so both are exercised side by side rather than
// separately, which is the property that matters -- a program written with one
// keeps working when the other exists.
struct Point {
    int x;
    int y;
    int Sum() { return x + y; }
    int Scaled(int k) { return (x + y) * k; }
}

class Counter {
    int n;
    Counter() { n = 0; }
    int Get() { return n; }
    void Bump() { n = n + 1; }
}

int main() {
    // auto and var produce the same thing.
    auto a = 3;
    var b = 4;
    Console.WriteLog(a + b);

    // auto with no initializer type to lean on: inference is the same path.
    auto s = "hi";
    auto f = 1.5;
    auto t = true;
    Console.WriteLog(s);
    Console.WriteLog(f);
    Console.WriteLog(t);

    // `->` on a struct pointer: a field.
    auto p = new Point(3, 4);
    auto q = &p;
    Console.WriteLog(q->x);
    Console.WriteLog(q->y);

    // `->` on a struct pointer: a method with no arguments.
    Console.WriteLog(q->Sum());

    // `->` on a struct pointer: a method with arguments.
    Console.WriteLog(q->Scaled(10));

    // `.` still works, and agrees with `->` on the same value.
    Console.WriteLog(q.x);
    Console.WriteLog(p.Sum());

    // `->` through a pointer held two levels of indirection away, so the
    // desugaring is exercised on a pointer-to-pointer rather than a fresh
    // `&p`.
    auto pp = &q;
    Console.WriteLog(pp->x);
    Console.WriteLog(pp->Sum());

    // A write through `->` lands in the same place a write through `.` does.
    q->x = 100;
    Console.WriteLog(p.x);
    p.y = 200;
    Console.WriteLog(q->y);
    Console.WriteLog(q->Sum());

    // `->` on a class pointer, including a method with no arguments.
    auto c = new Counter();
    auto cp = &c;
    cp->Bump();
    cp->Bump();
    cp->Bump();
    Console.WriteLog(cp->Get());

    // A method with a receiver passed as a parameter, reached with `->`.
    struct Take {
        int v;
        void Set(int n) { v = n; }
        int Get() { return v; }
    }
    auto t2 = new Take(0);
    auto tp = &t2;
    tp->Set(77);
    Console.WriteLog(tp->Get());
    Console.WriteLog(t2.v);
    return 0;
}
