int add(int a, int b) {
    return a + b;
}

int square(int n) {
    return n * n;
}

Console.WriteLog(add(3, 4));
Console.WriteLog(square(5));
Console.WriteLog(add(square(2), add(1, 1)));

int noReturn(int n) {
    if (n > 0) {
        return 1;
    }
    return 0;
}
Console.WriteLog(noReturn(5));
Console.WriteLog(noReturn(-1));
