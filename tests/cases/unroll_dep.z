// Loop unrolling, for the bodies that -O3 actually unrolls.
//
// tests/cases/unroll.z covers the shapes that have one loop-carried recurrence
// and are therefore left rolled. This file covers the other side of the -O3
// gate: each of those shapes rebuilt with a second independent recurrence, so the
// body is unrolled four deep. Without this the unrolled codepath would have no
// golden coverage at all, because every loop in the suite that used to reach it
// now rolls.
//
// The condition is tested before each copy rather than once per pass, so the
// thing that could differ is the iteration count: a trip count that is not a
// multiple of the factor, a zero-trip loop, `break` and `continue` inside a
// copy, and a float condition that cannot take the branch-on-compare path. Each
// shape appears twice, once rolled and once unrolled, and both are printed, so a
// change to either shows up in the golden output.
//
// The name says which it is, and that is not decoration: it is checked by
// tests/run.c's unrollgate cases for the gate itself, and these names are
// verified against `z asm` output. `overSizeCap` and the two nested loops are
// rolled for reasons other than having a single chain, and each says which.

int rolledPartial(int n) {
    var s = 0;
    for (var i = 0; i < n; i = i + 1) { s = s + i; }
    return s;
}

int unrolledPartial(int n) {
    var s = 0;
    var t = 0;
    for (var i = 0; i < n; i = i + 1) { s = s + i; t = t + 2; }
    return s;
}

int rolledZeroTrip() {
    var s = 0;
    for (var i = 0; i < 0; i = i + 1) { s = 99; }
    return s;
}

int unrolledZeroTrip() {
    // The stores have to be recurrences to make this body unrollable at all: a
    // body that only writes `s` and `t` has no chain to overlap, because nothing
    // reads them back. Zero trips means neither value is ever produced.
    var s = 0;
    var t = 0;
    for (var i = 0; i < 0; i = i + 1) { s = s + 99; t = t + 99; }
    return s + t;
}

int rolledBreaksOut() {
    var n = 0;
    for (var i = 0; i < 100; i = i + 1) {
        if (i == 6) { break; }
        n = n + 1;
    }
    return n;
}

int unrolledBreaksOut() {
    // `break` has to leave all four copies, not just the one it was written in.
    var n = 0;
    var m = 0;
    for (var i = 0; i < 100; i = i + 1) {
        if (i == 6) { break; }
        n = n + 1;
        m = m + 3;
    }
    return n + m / 3;
}

int rolledContinuesOn() {
    var s = 0;
    for (var i = 0; i < 10; i = i + 1) {
        if (i % 2 == 0) { continue; }
        s = s + i;
    }
    return s;
}

int unrolledContinuesOn() {
    // `continue` has to run the step of the copy it appears in and then branch on
    // to the next copy, not jump back to the top and re-run the body.
    var s = 0;
    var c = 0;
    for (var i = 0; i < 10; i = i + 1) {
        if (i % 2 == 0) { continue; }
        s = s + i;
        c = c + 1;
    }
    return s + 100 * c;
}

int rolledNested() {
    // Rolled because the body is a nested loop, which is a separate iteration
    // space: the outer body has one recurrence, `s`, and reading the inner
    // counter out of its condition would wrongly make that look like two.
    var s = 0;
    for (var i = 0; i < 5; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { s = s + 1; }
    }
    return s;
}

int unrolledNested() {
    // Same shape, and the outer loop is still rolled for the same reason, but the
    // inner body now has two chains, so the inner loop is the one unrolled.
    var s = 0;
    var t = 0;
    for (var i = 0; i < 5; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { s = s + 1; t = t + 1; }
    }
    return s + 10 * t;
}

int rolledNestedBreak() {
    var s = 0;
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 10; j = j + 1) {
            if (j == 2) { break; }
            s = s + 1;
        }
    }
    return s;
}

int unrolledNestedBreak() {
    // The `break` is in the inner body, so this is the unrolled copy that has to
    // get it right.
    var s = 0;
    var t = 0;
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 10; j = j + 1) {
            if (j == 2) { break; }
            s = s + 1;
            t = t + 1;
        }
    }
    return s + 10 * t;
}

int overSizeCap() {
    // 29 statements, over the size cap. Two chains would pass the dependence
    // test, so this is the case that shows the size gate still applies on top of
    // it: a body that does not fit the instruction cache gains nothing from being
    // copied four times, however parallel it is.
    var s = 0;
    var t = 0;
    for (var i = 0; i < 3; i = i + 1) {
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1;
        t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1;
        t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1;
    }
    return s + 10 * t;
}

int rolledFloatLoop() {
    var s = 0.0;
    for (var i = 0; i < 7; i = i + 1) { s = s + 0.5; }
    return (int)(s * 2.0);
}

int unrolledFloatLoop() {
    // A float condition cannot take the branch-on-compare path, so the unrolled
    // copies test it a different way and the body holds two float chains.
    var s = 0.0;
    var t = 0.0;
    for (var i = 0; i < 7; i = i + 1) { s = s + 0.5; t = t + 0.25; }
    return (int)(s * 2.0) + (int)(t * 4.0);
}

int main() {
    Console.WriteLog(rolledPartial(7));
    Console.WriteLog(unrolledPartial(7));     // 0+1..6 = 21
    Console.WriteLog(rolledPartial(16));
    Console.WriteLog(unrolledPartial(16));    // 0..15 = 120
    Console.WriteLog(rolledZeroTrip());
    Console.WriteLog(unrolledZeroTrip());     // 0
    Console.WriteLog(rolledBreaksOut());
    Console.WriteLog(unrolledBreaksOut());    // 6 iterations, m = 18
    Console.WriteLog(rolledContinuesOn());
    Console.WriteLog(unrolledContinuesOn());  // 1+3+5+7+9 = 25 over 5 iterations
    Console.WriteLog(rolledNested());
    Console.WriteLog(unrolledNested());       // 15
    Console.WriteLog(rolledNestedBreak());
    Console.WriteLog(unrolledNestedBreak());  // 4 * 2 = 8
    Console.WriteLog(overSizeCap());          // 3 * 12 = 36 each
    Console.WriteLog(rolledFloatLoop());
    Console.WriteLog(unrolledFloatLoop());    // 3.5 * 2 and 1.75 * 4
    return 0;
}
