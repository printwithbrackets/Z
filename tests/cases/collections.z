// Collections: Vec<T>, Map<K,V>, Set<T>.
//
// These are the *reference* semantics the roadmap asked about, so the aliasing
// is the first thing checked: assigning a Vec shares it, and that is the whole
// argument for making it a class.
int main() {
    /* ---- Vec: building, reading, growing ---- */
    var v = new Vec<int>();
    Console.WriteLog(v.size());             // 0
    Console.WriteLog(v.isEmpty());          // true
    for (var i1 = 0; i1 < 100; i1++) { v.push(i1 * i1); }
    Console.WriteLog(v.size());             // 100
    Console.WriteLog(v.at(0));              // 0
    Console.WriteLog(v.at(99));             // 9801
    Console.WriteLog(v.at(10));             // 100
    Console.WriteLog(v.capacity() >= 100);  // true

    /* Amortized growth: doubling means capacity is never far above length, and
     * 100 pushes never did more than a handful of copies. */
    Console.WriteLog(v.capacity() < 200);   // true

    /* ---- a Vec is a reference ---- */
    var alias = v;
    alias.push(12345);
    Console.WriteLog(v.size());             // 101 -- the same vector, not a copy
    v.push(999);
    Console.WriteLog(alias.size());          // 102

    /* ---- ends and middle ---- */
    Console.WriteLog(v.pop());              // 999
    Console.WriteLog(v.size());             // 101
    var mid = new Vec<string>();
    mid.push("a");
    mid.push("b");
    mid.push("c");
    Console.WriteLog(mid.removeAt(1));      // b
    Console.WriteLog(mid.join(","));        // a,c
    mid.insertAt(1, "X");
    Console.WriteLog(mid.join(","));        // a,X,c
    /* indexOf / contains / remove are absent on purpose: `==` on a class is
     * identity, so they would answer a different question for every element type
     * that is a reference. See lib/collections.z. */
    Console.WriteLog(mid.at(0));            // a
    Console.WriteLog(mid.at(2));            // c

    /* ---- ranges, both ends optional, clamped ---- */
    var r = new Vec<int>();
    for (var i2 = 0; i2 < 10; i2++) { r.push(i2); }
    Console.WriteLog(r.slice(2, 5).join(""));   // 234
    Console.WriteLog(r.sliceFrom(7).join(""));   // 789
    Console.WriteLog(r.sliceTo(3).join(""));     // 012
    Console.WriteLog(r.slice(8, 2).size());     // 0, an inverted range is empty
    Console.WriteLog(r.slice(-3, 99).join(""));  // 789
    Console.WriteLog(r.reversed().join(""));     // 9876543210
    Console.WriteLog(r.join(""));                // the original, untouched by slicing

    /* ---- take and drop ---- */
    Console.WriteLog(r.take(3).join(""));   // 012
    Console.WriteLog(r.size());             // 10 -- take copies
    var d = new Vec<int>();
    for (var i3 = 0; i3 < 5; i3++) { d.push(i3); }
    d.drop(2);
    Console.WriteLog(d.join(""));           // 234
    d.drop(99);
    Console.WriteLog(d.size());             // 0

    /* ---- clear keeps the buffer, release drops it ---- */
    var c = new Vec<int>();
    for (var i4 = 0; i4 < 50; i4++) { c.push(i4); }
    var capBefore = c.capacity();
    c.clear();
    Console.WriteLog(c.size());             // 0
    Console.WriteLog(c.capacity() == capBefore); // true
    c.release();
    Console.WriteLog(c.capacity() < capBefore);  // true

    /* ---- an element type with a text form of its own ---- */
    var texts = new Vec<string>();
    texts.push("one");
    texts.push("two");
    Console.WriteLog(texts.join(" + "));    // one + two
    var nums = new Vec<int>();
    nums.push(1);
    nums.push(2);
    nums.push(3);
    Console.WriteLog(nums.join("-"));       // 1-2-3
    Console.WriteLog(nums.toString());      // 1, 2, 3

    /* ---- Map: string keys ---- */
    var ages = new Map<string,int>();
    ages.set("ann", 34);
    ages.set("bob", 29);
    ages.set("cid", 41);
    Console.WriteLog(ages.size());          // 3
    Console.WriteLog(ages.get("bob", -1));  // 29
    Console.WriteLog(ages.get("nobody", -1)); // -1
    Console.WriteLog(ages.has("ann"));      // true
    Console.WriteLog(ages.has("nobody"));   // false
    Console.WriteLog(ages.remove("bob"));   // true
    Console.WriteLog(ages.remove("bob"));   // false
    Console.WriteLog(ages.size());          // 2
    Console.WriteLog(ages.get("bob", -1));  // -1
    ages.set("bob", 30);         // back in, and the size is right
    Console.WriteLog(ages.size());          // 3
    Console.WriteLog(ages.get("bob", -1));  // 30

    /* getOr computes a default only when there is nothing stored */
    Console.WriteLog(ages.getOr("ann", 0));        // 34, the default is not stored
    Console.WriteLog(ages.getOr("zoe", 1));        // 1
    Console.WriteLog(ages.get("zoe", -1));        // 1
    Console.WriteLog(ages.size());                 // 4

    /* Enough entries to force the table to grow, twice. The count has to survive
     * every rehash -- which is what a growable vector's rehash used to get wrong
     * at -O1, silently, after the first growth. */
    var many = new Map<int,int>();
    for (var i5 = 0; i5 < 500; i5++) { many.set(i5 * 3, i5); }
    Console.WriteLog(many.size());                 // 500
    var sum = 0;
    for (var i6 = 0; i6 < 500; i6++) { sum = sum + many.get(i6 * 3, -1); }
    Console.WriteLog(sum);                        // 124750
    Console.WriteLog(many.get(1, -1));             // -1, a key that was never set
    Console.WriteLog(many.get(3 * 499, -1));       // 499

    /* Keys that collide on their low bits would cluster if the hash did not
     * spread them; 0 and 1024 differ only in the bits a table masks on. */
    var spread = new Map<int,int>();
    for (var i7 = 0; i7 < 64; i7++) { spread.set(i7 * 1024, i7); }
    Console.WriteLog(spread.size());               // 64
    Console.WriteLog(spread.get(1024 * 33, -1));   // 33
    Console.WriteLog(spread.get(0, -1));           // 0

    /* Removing and re-adding is what a tombstone exists for: the probe has to
     * run past the hole rather than stopping at it. */
    var churn = new Map<int,int>();
    for (var n1 = 0; n1 < 40; n1++) { churn.set(n1, n1 * 10); }
    for (var n2 = 0; n2 < 40; n2 += 2) { churn.remove(n2); }
    Console.WriteLog(churn.size());                // 20
    for (var n3 = 0; n3 < 40; n3++) {
        if (n3 % 2 == 0) { Console.WriteLog(churn.has(n3)); } else { Console.WriteLog(churn.get(n3, -1) / 10); }
    }
    for (var n4 = 0; n4 < 40; n4++) { churn.set(n4, n4); }
    Console.WriteLog(churn.size());                // 40
    Console.WriteLog(churn.get(39, -1));           // 39

    /* A Map's own text form, which is what a failed assertion wants. */
    var small = new Map<string,int>();
    small.set("a", 1);
    Console.WriteLog(small.toString().length >= 3); // true -- at least "a=1"
    small.clear();
    Console.WriteLog(small.size());                // 0

    /* ---- Map: int keys, and a struct as one ---- */
    struct Key { int a; int b; }
    var keys = new Map<int,string>();
    for (var i11 = 0; i11 < 20; i11++) { keys.set(i11, int_to_string(i11 * 100)); }
    Console.WriteLog(keys.get(7, "?"));            // 700
    Console.WriteLog(keys.size());                 // 20

    /* ---- Set ---- */
    var seen = new Set<string>();
    Console.WriteLog(seen.size());                 // 0
    Console.WriteLog(seen.addIfNew("a"));          // true
    Console.WriteLog(seen.addIfNew("a"));          // false
    Console.WriteLog(seen.addIfNew("b"));          // true
    Console.WriteLog(seen.size());                 // 2
    Console.WriteLog(seen.has("a"));               // true
    Console.WriteLog(seen.has("z"));               // false
    Console.WriteLog(seen.remove("a"));            // true
    Console.WriteLog(seen.size());                 // 1

    /* The counting idiom the whole shape exists for. */
    var dupes = new Set<int>();
    var data = new Vec<int>();
    for (var i12 = 0; i12 < 100; i12++) { data.push(i12 % 30); }
    var distinct = 0;
    for (var i13 = 0; i13 < data.size(); i13++) {
        if (dupes.addIfNew(data.at(i13))) { distinct = distinct + 1; }
    }
    Console.WriteLog(distinct);                    // 30
    Console.WriteLog(dupes.size());                // 30

    /* set relations */
    var x = new Set<int>();
    var y = new Set<int>();
    for (var i14 = 0; i14 < 5; i14++) { x.add(i14); y.add(i14); }
    y.add(99);
    Console.WriteLog(x.containsAll(y));            // false
    Console.WriteLog(y.containsAll(x));            // true
    Console.WriteLog(x.isEqualTo(x));              // true
    y.remove(99);
    Console.WriteLog(x.isEqualTo(y));              // true

    /* A Set of 2000, which forces the inner map to rehash. */
    var big = new Set<int>();
    for (var i15 = 0; i15 < 2000; i15++) { big.add(i15 * 5); }
    Console.WriteLog(big.size());                  // 2000
    Console.WriteLog(big.has(9995));               // true
    Console.WriteLog(big.has(9994));               // false

    /* ---- a vector of vectors: the case the class decision is about ---- */
    var grid = new Vec<Vec<int>*>();
    for (var row = 0; row < 3; row++) {
        var line = new Vec<int>();
        for (var col = 0; col < 3; col++) { line.push(row * 3 + col); }
        grid.push(line);
    }
    Console.WriteLog(grid.size());                 // 3
    Console.WriteLog(grid.at(1).at(1));            // 4
    grid.at(0).push(99);
    Console.WriteLog(grid.at(0).size());           // 4
    Console.WriteLog(grid.at(0).join(""));         // 01299
    return 0;
}
