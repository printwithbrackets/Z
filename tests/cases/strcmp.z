// Strings support all six relational operators, ordered lexicographically.
int main() {
    Console.WriteLog("hello" == "hello" ? 1 : 0);        // 1
    Console.WriteLog("hello" == "world" ? 1 : 0);        // 0
    Console.WriteLog("hello" != "world" ? 1 : 0);        // 1

    var a = "apple";
    var b = "banana";
    Console.WriteLog(a < b ? 1 : 0);                     // 1
    Console.WriteLog(b < a ? 1 : 0);                     // 0
    Console.WriteLog("abc" <= "abc" ? 1 : 0);            // 1
    Console.WriteLog("abc" < "abd" ? 1 : 0);             // 1
    Console.WriteLog("b" > "a" ? 1 : 0);                 // 1

    /* prefix ordering: shorter sorts first, like C's strcmp */
    Console.WriteLog("ab" < "abc" ? 1 : 0);              // 1
    Console.WriteLog("abc" < "ab" ? 1 : 0);              // 0

    /* case and digits order by byte value */
    Console.WriteLog("B" < "a" ? 1 : 0);                 // 1
    Console.WriteLog("a" < "b" ? 1 : 0);                 // 1
    Console.WriteLog("1" < "2" ? 1 : 0);                 // 1

    var x = "z";
    var y = "z";
    Console.WriteLog(x == y ? 1 : 0);                    // 1
    Console.WriteLog(x != y ? 1 : 0);                    // 0

    /* usable directly as a condition, and in both operand positions */
    if ("q" == "q") { Console.WriteLog(99); }            // 99
    if ("q" > "p") { Console.WriteLog(98); }             // 98

    /* a computed string, not just literals */
    var s1 = "foo";
    var s2 = "f" + "oo";
    Console.WriteLog(s1 == s2 ? 1 : 0);                  // 1
    return 0;
}
