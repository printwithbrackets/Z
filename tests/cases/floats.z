// The float type: literals, arithmetic, comparison, conversion, and how a float
// moves through calls, structs, classes, arrays and loops.

float half(float v) { return v / 2.0; }
float add3(float a, float b, float c) { return a + b + c; }
int mixed(int n, float f) { return n + (int)f; }
float recip(float x) { return 1.0 / x; }

struct Vec {
    float x;
    float y;
    float Len2() { return x * x + y * y; }
    float Dot(Vec o) { return x * o.x + y * o.y; }
    Vec Add(Vec o) { return new Vec(x + o.x, y + o.y); }
}

class Box {
    float v;
    Box(float x) { v = x; }
    float Get() { return v; }
}
class Gauge {
    float v;
    Gauge(float x) { v = x; }
    virtual float Read() { return v; }
    virtual float Scale(float k) { return v * k; }
}

int Twice(this int n) { return n * 2; }

int main() {
    // ---- literals --------------------------------------------------------
    // A '.' starts a fraction only before a digit, which is what leaves
    // `21.Twice()` a member access rather than the integer 21 followed by junk.
    print(1.5);
    print(0.5);
    print(100.0);
    print(1e3);
    print(1.5e2);
    print(2E-2);
    print(21.Twice());
    print(0.1 + 0.2);              // 0.3, at six significant digits

    // ---- arithmetic ------------------------------------------------------
    var x = 1.5;
    print(x + 0.25);
    print(x - 0.5);
    print(x * 2.0);
    print(x / 0.5);
    print(-x);
    var y = 2;                      // an int widens, and the whole expression
    print(x + y);                   // becomes a float
    var acc = 1.0;
    acc += 0.5;
    acc -= 0.25;
    acc *= 4.0;
    acc /= 2.0;
    print(acc);

    // ---- comparison ------------------------------------------------------
    print(x > 1.0);
    print(x < 1.0);
    print(x >= 1.5);
    print(x <= 1.5);
    print(x == 1.5);
    print(x != 1.5);
    print(x > 1.0 && x < 2.0);
    print(x > 2.0 || x < 2.0);
    if (x > 1.0) { print("positive"); }

    // ---- conversion ------------------------------------------------------
    // float -> int truncates toward zero, never rounds.
    print((int)3.9);
    print((int)-3.9);
    print((int)0.5);
    print((float)3);
    // Every int is exactly representable as a float, so this widening is exact.
    print((float)9007199254740993 == 9007199254740992.0);
    // ...and assigning a float to an int is refused rather than truncated.
    // (see tests/errors/float_to_int.z)

    // ---- infinities and NaN ----------------------------------------------
    // IEEE-754, not a trap: division by zero is an infinity.
    print(recip(0.0));
    print(-recip(0.0));
    var nan = 0.0 / 0.0;
    // NaN compares false against everything, including itself, in every
    // direction. This is the case a hand-written comparison gets wrong.
    print(nan == nan);
    print(nan != nan);
    print(nan < 1.0);
    print(nan > 1.0);
    print(nan <= 1.0);
    print(nan >= 1.0);

    // ---- calls -----------------------------------------------------------
    print(half(10.0));
    print(add3(1.0, 2.0, 3.0));
    // The integer and vector argument registers are numbered independently, so
    // a float argument does not shift the integers that follow it.
    print(mixed(1, 2.5));
    print(mixed(7, 0.5));

    // ---- structs, classes, arrays ----------------------------------------
    var a = new Vec(3.0, 4.0);
    var b = new Vec(1.0, 2.0);
    print(a.Len2());
    print(a.Dot(b));
    var c = a.Add(b);
    print(c.x);
    print(c.y);
    var box = new Box(2.5);
    print(box.Get());
    box.v = 4.5;
    print(box.v);
    // A constructor and a virtual method both take a float while a receiver
    // occupies rdi, so the declared arguments arrive in the integer sequence
    // rather than xmm0. Staging these with gen_expr saved rax instead of the
    // value, which printed the receiver's address as a denormal double.
    var gauge = new Gauge(3.0);
    print(gauge.Read());
    print(gauge.Scale(4.0));
    var g2 = new Gauge(5.0);
    print(g2.Scale(2.0));
    var fs = new float[3];
    fs[0] = 1.5;
    fs[1] = 2.5;
    fs[2] = 3.0;
    print(fs.length);
    print(fs[0] + fs[1] + fs[2]);
    var sum = 0.0;
    foreach (var v in fs) {
        sum = sum + v;
    }
    print(sum);

    // ---- control flow ----------------------------------------------------
    var t = true ? 1.5 : 2.5;
    print(t);
    var u = false ? 1.5 : 2.5;
    print(u);
    print(a.Len2() > a.Dot(b));

    // Concatenation converts a float to text the same way it converts an int,
    // and the two spell a number identically.
    print("v = " + 1.5);
    print(1.5 + " is a float");
    print("sum " + (1.5 + 2.5));

    // A float accumulator in a hot loop, divided by a value that changes every
    // iteration. None of the integer strength reduction applies, and the answer
    // must be the same at every optimization level.
    var h = 0.0;
    for (var i = 1; i <= 100; i++) {
        h = h + 1.0 / (float)i;
    }
    print(h);
    return 0;
}
