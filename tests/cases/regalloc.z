// Register-allocator + constant-propagation stress: >5 live locals (spills),
// shadowing, locals live across calls, conditional and compound assignment,
// loops, address-taken locals, and constant folding that must NOT alias a
// pointer-mutable local.
int helper(int p, int q) { var t = p * 2; return t + q; }

int main() {
    var a = 1; var b = 2; var c = 3; var d = 4; var e = 5;
    var f = 6; var g = 7; var h = 8; var i = 9; var j = 10;
    var keep = 100;
    var r = helper(keep, 1);
    print(r);                 // 201
    print(keep);              // 100
    var x = 5;
    { var x = 99; print(x); } // 99 (inner shadows)
    print(x);                 // 5
    var y = 0;
    if (r > 50) { y = 7; } else { y = 3; }
    print(y);                 // 7
    var s = 0;
    for (var k = 0; k < 5; k = k + 1) { s = s + k; }
    print(s);                 // 10
    a += 10; b -= 1; c *= 3; d /= 2; e %= 4;
    print(a); print(b); print(c); print(d); print(e); // 11 1 9 2 1
    var p = 42;               // address taken: must NOT be const-folded
    var ptr = &p;
    *ptr = *ptr + 1;
    print(p);                 // 43
    var m = 0; var n = 10;
    while (m < n) { m = m + 3; n = n - 1; }
    print(m); print(n);       // 9 7
    return 0;
}
