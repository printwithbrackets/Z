// The parts of Vec<T>, Map<K,V> and Set<T> that the collections test does not
// reach.
//
// `collections` covers the common path: building, aliasing, growth, the ends.
// This covers the rest of the declared surface, one method per line, so a method
// that stops working is a failing line here rather than a surprise in a program
// that uses it. Every value printed is the one the method's comment claims.
int main() {
    /* ---- Vec: views and partial operations ---- */
    var v = new Vec<int>();
    for (var i = 0; i < 5; i++) {
        v.push(i);
    }
    Console.WriteLog(v.reversed().toString());      // 3, 2, 1, 0
    Console.WriteLog(v.slice(1, 3).toString());      // 1, 2
    Console.WriteLog(v.sliceFrom(2).toString());    // 2, 3
    Console.WriteLog(v.sliceTo(2).toString());      // 0, 1
    Console.WriteLog(v.take(2).toString());         // 0, 1
    Console.WriteLog(v.join("|"));                  // 0|1|2|3
    var head = v.take(2);
    v.pushAll(head);
    Console.WriteLog(v.size());                     // 7
    v.drop(1);
    Console.WriteLog(v.size());                     // 6

    /* clear keeps the buffer, release frees it, and both empty the vector. */
    v.clear();
    Console.WriteLog(v.isEmpty());                  // true
    v.push(1);
    v.release();
    Console.WriteLog(v.isEmpty());                  // true

    /* ---- Map: fallback reads, computed defaults, and iteration ---- */
    var m = new Map<string, int>();
    m.set("a", 1);
    m.set("b", 2);
    Console.WriteLog(m.get("a", -1));               // 1
    Console.WriteLog(m.get("zz", -1));              // -1 -- absent is an ordinary answer
    Console.WriteLog(m.getOr("c", 30));             // 30
    Console.WriteLog(m.size());                     // 3 -- getOr inserted it
    Console.WriteLog(m.slots() >= m.size());        // true
    Console.WriteLog(m.keysOf().size());            // 3
    Console.WriteLog(m.values().size());            // 3
    Console.WriteLog(m.join(" "));                  // three k=v pairs
    Console.WriteLog(m.remove("a"));                // true -- it was there
    Console.WriteLog(m.remove("a"));                // false -- it is not
    m.clear();
    Console.WriteLog(m.isEmpty());                  // true

    /* ---- Set: addIfNew, subset, equality ---- */
    var s = new Set<int>();
    s.add(1);
    s.add(2);
    s.add(1);
    Console.WriteLog(s.size());                     // 2 -- a second add changes nothing
    Console.WriteLog(s.addIfNew(3));                // true -- 3 was not there
    Console.WriteLog(s.addIfNew(3));                // false -- it is now
    Console.WriteLog(s.has(1));                     // true
    Console.WriteLog(s.has(99));                    // false
    var sub = new Set<int>();
    sub.add(1);
    sub.add(3);
    Console.WriteLog(s.containsAll(sub));           // true
    Console.WriteLog(sub.isEqualTo(s));             // false -- s has an element sub lacks
    Console.WriteLog(s.isEqualTo(s));               // true
    Console.WriteLog(s.remove(1));                  // true
    Console.WriteLog(s.size());                     // 2

    /* ---- the same containers keyed by float, which is a different lowering
     * of the hash rather than the same one reached differently ---- */
    var mf = new Map<float, int>();
    mf.set(1.5, 10);
    mf.set(2.5, 20);
    Console.WriteLog(mf.get(1.5, -1));              // 10
    Console.WriteLog(mf.get(2.5, -1));              // 20
    Console.WriteLog(mf.size());                    // 2
    var sf = new Set<float>();
    sf.add(1.5);
    Console.WriteLog(sf.has(1.5));                  // true

    /* ---- the C++ spellings, which are aliases for the ones above and must
     * therefore answer identically rather than being a second implementation
     * that can drift ---- */
    var cv = new Vec<int>();
    Console.WriteLog(cv.empty());                   // true
    cv.push_back(1);
    cv.push(2);
    cv.push_back(3);
    Console.WriteLog(cv.size());                    // 3
    Console.WriteLog(cv.empty());                   // false
    Console.WriteLog(cv.pop_back());                // 3
    Console.WriteLog(cv.pop());                     // 2 -- and the same value push_back put there
    Console.WriteLog(cv.size());                    // 1
    var cm = new Map<string, int>();
    Console.WriteLog(cm.empty());                   // true
    cm.set("a", 1);
    Console.WriteLog(cm.empty());                   // false
    var cs = new Set<int>();
    Console.WriteLog(cs.empty());                   // true
    cs.add(1);
    Console.WriteLog(cs.empty());                   // false
    Console.WriteLog(cs.has(1));                    // true
    return 0;
}
