struct Point {
    int x;
    int y;
}

int getX(Point* p) { return p.x; }
void bump(Point* p) { p.x = p.x + 100; }

int main() {
    var p = new Point(3, 4);
    print(p.x);
    print(p.y);
    p.x = 10;
    print(p.x);

    // struct assignment copies by value
    var q = p;
    q.x = 99;
    print(p.x);
    print(q.x);

    // pass by pointer
    print(getX(&p));
    bump(&p);
    print(p.x);
    return 0;
}
