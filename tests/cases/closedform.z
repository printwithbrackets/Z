// Closed-form induction variables: a counted loop whose body only accumulates
// loop-invariant amounts is replaced by the arithmetic that produces the same
// answer without running the loop.
//
// The pattern is narrow, and most of this file is about the ways a loop can look
// like the pattern without being it. Each of those must run the loop.

int main() {
    // ---- solved: the body adds a constant, so the total is a product ----
    {
        var a = 3; var b = 5; var c = 7; var d = 11;
        var sum = 0; var i = 0;
        while (i < 1000) { sum = sum + a * b + c * d - (a + c); i = i + 1; }
        Console.WriteLog(sum);                      // 1000 * 82
    }

    // ---- solved: several updates to one accumulator, and a `for` header ----
    {
        var sum = 0;
        for (var i = 0; i < 100; i = i + 1) { sum += 2; sum -= 1; }
        Console.WriteLog(sum);                      // 100
    }

    // ---- solved: and the loop variable is left where the loop left it ----
    // The replacement block assigns the accumulators and used to assign nothing
    // else, so a read of `i` after the loop saw the value from *before* it. That
    // is the one observable consequence of a rewrite that is otherwise invisible:
    // a loop can be removed and the only thing that gives it away is a read of
    // the variable that drove it.
    {
        var sum = 0; var i = 0;
        while (i < 10) { sum = sum + 1; i = i + 1; }
        Console.WriteLog(sum);                      // 10
        Console.WriteLog(i);                        // 10, not 0
    }
    {
        var sum = 0; var i = 0;
        while (i < 7) { sum = sum + 2; i = i + 3; }
        Console.WriteLog(sum);                      // 3 iterations of +2
        Console.WriteLog(i);                        // 9
    }

    // ---- solved: a downward loop, and a non-unit stride ----
    // The stride sign has to agree with the comparison for this to be solved on
    // purpose. `i > 0` with `i = i - 4` walks down towards zero, so the stride is
    // negative and the comparison is a downward one. The pass used to negate the
    // stride for a downward comparison, which made every genuinely downward loop
    // look like a sign mismatch and left it to run. `closedform_down` is the
    // regression test for that; what is asserted here is the answer, which was
    // right before and after for the only reason that the loop ran.
    {
        var sum = 0; var i = 100;
        while (i > 0) { sum = sum + 3; i = i - 4; }
        Console.WriteLog(sum);                      // 25 iterations of +3
        Console.WriteLog(i);                        // 0, and the pass has to say so
    }

    // ---- solved: a constant start found by looking back, not by a `for` ----
    {
        var sum = 0; var i = 0;
        i = 5;                            // the start is here, not a declaration
        while (i < 9) { sum = sum + 1; i = i + 1; }
        Console.WriteLog(sum);                      // 4
    }

    // ---- solved: a `for` whose initializer assigns the loop variable ----
    // The start is looked for in the initializer, and the initializer here is an
    // assignment rather than a declaration. Missing that made the pass fall
    // through to the backward scan, which found `var i = 0` and computed four
    // extra iterations. The rule is the one the scan already uses: any statement
    // with the loop variable on its left is a write, and the nearest one wins.
    {
        var sum = 0; var i = 0;
        for (i = 5; i < 9; i = i + 1) { sum = sum + 1; }
        Console.WriteLog(sum);                      // 4
        Console.WriteLog(i);                        // 9
    }

    // ---- not solved: the amount reads the accumulator, so it is not invariant
    {
        var sum = 0; var i = 0;
        while (i < 10) { sum = sum + sum; i = i + 1; }
        Console.WriteLog(sum);                      // 0
    }

    // ---- not solved: a string accumulator ----
    // `s = s + "x"` has the shape of an accumulate, and multiplying a string by
    // the trip count is not a thing. This is the one that used to fail to compile.
    {
        var s = "";
        var i = 0;
        while (i < 5) { s = s + "x"; i = i + 1; }
        Console.WriteLog(s + "!");
    }

    // ---- not solved: a call in the body ----
    // A call whose answer changes per invocation used to look loop-invariant,
    // because the pass cannot see what the callee does. It does see a call's
    // *arguments*, so a call that mentions the loop variable is rejected for the
    // ordinary reason. What it cannot see is inside the callee, and a function
    // that answers differently each time is the ordinary case for anything that
    // reads input, a clock or a random source.
    //
    // `closedform_call` is the regression test for that, and it needs a `.stdin`
    // to be wrong in a way that shows. The case here is the shape that always
    // worked, and it is here to say so rather than to imply the whole section
    // moved.
    {
        var n = 0; var i = 0;
        while (i < 5) { n = n + step(); i = i + 1; }
        Console.WriteLog(n);                        // 15
    }

    // ---- not solved: an early exit changes the trip count ----
    {
        var sum = 0; var i = 0;
        while (i < 100) { if (i == 6) { break; } sum = sum + 1; i = i + 1; }
        Console.WriteLog(sum);                      // 6
    }

    // ---- not solved: `continue` ----
    // A `for` so the step is in the header: in a `while` the step would be the
    // last statement of the body, and `continue` would skip past it forever.
    {
        var sum = 0;
        for (var i = 0; i < 10; i = i + 1) {
            if (i % 2 == 0) { continue; }
            sum = sum + 1;
        }
        Console.WriteLog(sum);                      // 5
    }

    // ---- not solved: a multiply, which would need a power ----
    {
        var p = 1; var i = 0;
        while (i < 5) { p = p * 2; i = i + 1; }
        Console.WriteLog(p);                        // 32
    }

    // ---- not solved: a start that is not a constant ----
    {
        var from = 3 + 1;                // folds to a constant, so this one *is* solved
        var sum = 0; var i = from;
        while (i < 7) { sum = sum + 1; i = i + 1; }
        Console.WriteLog(sum);                      // 3
    }

    return 0;
}

int step() { return 3; }

