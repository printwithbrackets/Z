// Three independent recurrences rather than two. The gate is a threshold and
// this checks it is a threshold in the right direction, not a test for exactly
// two. Unrolled.
int main() {
    var a = 1;
    var b = 2;
    var c = 3;
    var i = 0;
    while (i < 100) {
        a = a * 3 + 1;
        b = b + 2;
        c = c * 5 - 1;
        i = i + 1;
    }
    print(a);
    print(b);
    print(c);
    return 0;
}
