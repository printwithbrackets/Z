// `for(;;)` has no condition to test before each copy, so the unrolled form
// cannot be made safe for an unknown trip count at all. Two chains or not, it is
// never unrolled. Left rolled.
int main() {
    var a = 1;
    var b = 2;
    var i = 0;
    for (;;) {
        a = a * 3 + 1;
        b = b + 2;
        i = i + 1;
        if (i > 100) {
            break;
        }
    }
    Console.WriteLog(a);
    Console.WriteLog(b);
    return 0;
}
