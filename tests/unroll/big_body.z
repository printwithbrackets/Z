// 29 statements, over the unrolling size cap, with two independent chains. The
// size gate still applies on top of the dependence gate: a body that does not
// fit the instruction cache gains nothing from being copied four times, however
// parallel it is. Left rolled.
int main() {
    var s = 0;
    var t = 0;
    var i = 0;
    while (i < 100) {
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        s = s + 1; t = t + 1; s = s + 1; t = t + 1;
        i = i + 1;
    }
    print(s);
    print(t);
    return 0;
}
