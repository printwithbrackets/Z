{
  "testCommand": "make test",
  "formatCommand": "clang-format -i src/*.c include/*.h tests/*.c src/parser/*.inc src/codegen/*.inc",
  "lintCommand": "make",
  "supportedLanguages": ["c"],
  "testFramework": "custom (tests/run.c golden + diagnostic harness)",
  "formatter": "clang-format",
  "linter": "gcc -Wall -Wextra -Wpedantic -Werror",
  "commitConvention": "conventional",
  "minimumTestCoverage": 80,
  "protectedBranches": ["main", "master"],
  "requireCodeReview": true,
  "allowDirectPushes": false,
  "cicdPlatform": "github-actions"
}
