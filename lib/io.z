/* File I/O: the `Result` layer over the raw descriptor builtins.
 *
 * The builtins (`open`, `close`, `read_byte`, `write_bytes`, `read_line`,
 * `io_errno`, `io_eof`) are the floor: they report failure as -1 and leave the
 * reason in errno. This file is the layer the roadmap asks for, turning that
 * into a value: `Result<File*, IoError*>` from the opener, `Result<_, IoError*>`
 * from everything that can fail afterwards.
 *
 * Both sides are classes because a `Result` payload must be one machine word.
 * A class handle is a pointer, so it fits; a struct by value does not. That is
 * also what lets the error carry a message without the `Result` growing.
 *
 * End of file is an `Err` with code 0 rather than a third state, so a loop
 * ends in the same arm an error does and tells the two apart by the code.
 * `readLine` follows the builtin it wraps: a line without its terminator, and
 * an `Err` only when nothing was read because the end was already there. An
 * empty line in the middle of a file is `Ok("")`, not the end.
 */

class IoError {
    int code;
    string message;

    IoError(int c, string m) { this.code = c; this.message = m; }

    string describe() { return this.message + " (errno " + int_to_string(this.code) + ")"; }
}

class File {
    int fd;
    bool closed;

    File(int f) { this.fd = f; this.closed = false; }

    /* Closes on scope end if the program did not. An explicitly closed file
     * stays closed rather than closing twice. */
    ~File() { if (!this.closed) { close(this.fd); } }

    /* The bytes written, or why the write failed. */
    Result<int, IoError*> write(string s) {
        var n = write_bytes(this.fd, s);
        if (n < 0) { return Err(new IoError(io_errno(), "write failed")); }
        return Ok(n);
    }

    /* writes `s` plus a newline, which is the shape most line oriented output
     * takes. two calls rather than a temporary, so no short lived string is
     * allocated on the way */
    Result<int, IoError*> writeLine(string s) {
        var a = write_bytes(this.fd, s);
        if (a < 0) { return Err(new IoError(io_errno(), "write failed")); }
        var b = write_bytes(this.fd, "\n");
        if (b < 0) { return Err(new IoError(io_errno(), "write failed")); }
        return Ok(a + b);
    }

    /* One byte in 0..255, or the end (`code == 0`) or why the read failed. */
    Result<int, IoError*> readByte() {
        var b = read_byte(this.fd);
        if (b >= 0) { return Ok(b); }
        if (io_eof() != 0) { return Err(new IoError(0, "end of file")); }
        return Err(new IoError(io_errno(), "read failed"));
    }

    /* A line without its terminator, or the end when nothing was left to read.
     * A read error partway through is the line so far: the builtin it wraps
     * reports the end and the error the same way, and inventing a distinction
     * here would be guessing rather than reporting.
     *
     * `move` hands the line to the `Ok` rather than sharing it: without it the
     * scope teardown releases the local's bytes on the way out, leaving the
     * payload pointing at memory nothing owns. An `int` payload needs none of
     * this, which is why `readByte` above does not say it. */
    Result<string, IoError*> readLine() {
        var line = read_line(this.fd);
        if (len(line) == 0 && io_eof() != 0) { return Err(new IoError(0, "end of file")); }
        return Ok(move line);
    }

    /* the whole rest of the file, byte for byte apart from line ending
     * normalization. reading it as lines is this plus `lines`: the text
     * split on newlines, which is two calls rather than a helper returning a
     * vector because that helper would name `Vec<string>` and break every
     * unit declaring its own `Vec`. read a byte at a time rather than a line
     * at a time, because the end of file flag is sticky: once any read has
     * hit the end it stays set, so asking it after a successful line tells
     * nothing about that line. here it is only asked right after a failed
     * read, where it names this read and nothing else. a carriage return
     * counts as a newline like the builtin reader counts it, so windows text
     * comes back with plain newlines, and a read error is an `Err` rather
     * than a guess */
    Result<string, IoError*> readAllText() {
        var out = new StringBuilder();
        var pending = false;
        while (true) {
            var b = read_byte(this.fd);
            if (b < 0) {
                if (io_eof() != 0) { break; }
                return Err(new IoError(io_errno(), "read failed"));
            }
            if (b == 13) {
                pending = true;
                continue;
            }
            if (pending) {
                pending = false;
                out.append("\n");
                if (b == 10) { continue; }
            }
            if (b == 10) {
                out.append("\n");
            } else {
                out.appendByte(b);
            }
        }
        if (pending) { out.append("\n"); }
        var text = out.take();
        return Ok(move text);
    }

    /* Closes, and remembers it did so the destructor does not again. Closing
     * twice is `Ok(0)` rather than an error: the file is closed either way,
     * which is what the caller asked about. */
    Result<int, IoError*> close() {
        if (this.closed) { return Ok(0); }
        var r = close(this.fd);
        this.closed = true;
        if (r < 0) { return Err(new IoError(io_errno(), "close failed")); }
        return Ok(r);
    }
}

/* Opens `path` in mode "r", "w" or "a" ("w" truncates, "a" appends). A bad
 * mode and a missing file are both an `Err` carrying errno and the path,
 * which is the part with any use in it. */
Result<File*, IoError*> openFile(string path, string mode) {
    var fd = open(path, mode);
    if (fd < 0) { return Err(new IoError(io_errno(), "open failed: " + path)); }
    return Ok(new File(fd));
}

/* true when `path` can be opened for reading. a probe rather than a stat,
 * because readability is the question a program is actually asking */
bool file_exists(string path) {
    var fd = open(path, "r");
    if (fd < 0) { return false; }
    close(fd);
    return true;
}

/* the whole file at `path` as one string. the `?` chain is what this operator
 * is for, since each step can fail with the same error type and the first
 * failure is the answer */
Result<string, IoError*> file_read(string path) {
    var f = openFile(path, "r")?;
    var text = f.readAllText()?;
    f.close()?;
    return Ok(move text);
}

/* writes `data` to `path`, truncating what was there. answers the byte count
 * so a short write is visible rather than silent */
Result<int, IoError*> file_write(string path, string data) {
    var f = openFile(path, "w")?;
    var n = f.write(data)?;
    f.close()?;
    return Ok(n);
}

/* appends `data` to `path`, creating it when it is missing. the same shape as
 * `file_write` apart from the mode, because that is the only difference */
Result<int, IoError*> file_append(string path, string data) {
    var f = openFile(path, "a")?;
    var n = f.write(data)?;
    f.close()?;
    return Ok(n);
}
