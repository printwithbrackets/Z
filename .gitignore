# Build artifacts. Objects, dep files, and the two generated headers
# (embedding runtime/z_rt.c and lib/*.z) all live under build/.
/build/
/z
/gzz
/tests/run
/tests/run.d

# Compiler output
*.s
*.out
# Embedded runtime temp files
/tmp/z_*

# A mistyped relative path creates a literal `..../` directory. It is never
# source -- only a place a stale compiler binary or stray output landed -- so it
# is ignored rather than committed by accident.
/..../

# Python bytecode. tools/embed.py is imported by tests/embed_test.py, so
# running the tests leaves a __pycache__ behind.
/__pycache__/
